function(set_c_flags)
    set(COMMON_FLAGS
        " -Wall"
        " -Wextra"
        " -Wpedantic"
        " -fPIC"
        " -MMD"
    )
    if (CMAKE_C_COMPILER_ID STREQUAL "GNU")
        string(CONCAT FLAGS "${COMMON_FLAGS}" " -MP")
    elseif (CMAKE_C_COMPILER_ID STREQUAL "AppleClang")
        set(FLAGS "${COMMON_FLAGS}")
    else()
        message(FATAL_ERROR "Unsupported compiler. Only GCC and AppleClang are supported. Compiler ID: ${CMAKE_C_COMPILER_ID}")
        return()
    endif ()
    set(CMAKE_C_FLAGS ${FLAGS} CACHE INTERNAL "")
endfunction()

function(set_cxx_flags)
    set(COMMON_FLAGS
        " -Wall"
        " -Wextra"
        " -Wpedantic"
        " -fPIC"
        " -MMD"
        " -std=c++17"
    )
    if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        string(CONCAT FLAGS "${COMMON_FLAGS}" " -MP")
    elseif (CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
        set(FLAGS "${COMMON_FLAGS}")
    else()
        message(FATAL_ERROR "Unsupported compiler. Only GCC and AppleClang are supported. Compiler ID: ${CMAKE_CXX_COMPILER_ID}")
        return()
    endif ()
    set(CMAKE_CXX_FLAGS ${FLAGS} CACHE INTERNAL "")
endfunction()

function(set_compiler_settings)
    if(CMAKE_C_COMPILER_ID)
        set_c_flags()
    endif()
    if(CMAKE_CXX_COMPILER_ID)
        set_cxx_flags()
    endif()
    set(CMAKE_EXE_LINKER_FLAGS    "-Wl,--as-needed ${CMAKE_EXE_LINKER_FLAGS}")
    set(CMAKE_SHARED_LINKER_FLAGS "-Wl,--as-needed ${CMAKE_SHARED_LINKER_FLAGS}")
endfunction()

if(DEFINED CUSTOM_C_FLAGS)
    set(CMAKE_CXX_FLAGS ${CUSTOM_C_FLAGS} CACHE STRING "" FORCE)
endif()
