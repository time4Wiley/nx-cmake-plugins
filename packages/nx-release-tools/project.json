{
    "name": "nx-release-tools",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/nx-release-tools/src",
    "projectType": "library",
    "release": {
        "version": {
            "manifestRootsToUpdate": ["dist/{projectRoot}"],
            "currentVersionResolver": "git-tag",
            "fallbackCurrentVersionResolver": "disk"
        }
    },
    "tags": [],
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/packages/nx-release-tools",
                "main": "packages/nx-release-tools/src/index.ts",
                "tsConfig": "packages/nx-release-tools/tsconfig.lib.json",
                "assets": [
                    "packages/nx-release-tools/generators.json",
                    "packages/nx-release-tools/executors.json",
                    {
                        "input": "packages/nx-release-tools/src",
                        "glob": "**/*.json",
                        "output": "src"
                    },
                    {
                        "input": "packages/nx-release-tools/src",
                        "glob": "**/*.js__tmpl__",
                        "output": "src"
                    },
                    {
                        "input": "packages/nx-release-tools/src",
                        "glob": "**/*.sh__tmpl__",
                        "output": "src"
                    },
                    {
                        "input": "packages/nx-release-tools/src",
                        "glob": "**/*.json__tmpl__",
                        "output": "src"
                    },
                    {
                        "input": "packages/nx-release-tools/bin",
                        "glob": "**/*",
                        "output": "bin"
                    }
                ]
            }
        },
        "nx-release-publish": {
            "options": {
                "packageRoot": "dist/{projectRoot}"
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "packages/nx-release-tools/jest.config.ts"
            }
        }
    }
}
