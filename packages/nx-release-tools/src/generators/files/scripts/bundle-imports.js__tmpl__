#!/usr/bin/env node
/**
 * Bundle internal dependencies and fix TypeScript path aliases
 * This script is automatically generated by @time4peter/nx-release-tools
 */

const fs = require('fs');
const path = require('path');

// Configuration from .nx-release.json
const config = JSON.parse(fs.readFileSync('.nx-release.json', 'utf8'));
const aliasMap = config.bundling?.aliases || {};

// Copy internal packages to dist
function copyInternalPackages(packagePath, distPath) {
  console.log(`📦 Bundling internal dependencies for ${packagePath}...`);
  
  for (const [alias, internalPkg] of Object.entries(aliasMap)) {
    const sourcePath = path.resolve(internalPkg);
    const targetPath = path.join(distPath, path.basename(internalPkg));
    
    if (fs.existsSync(sourcePath)) {
      console.log(`  Copying ${alias} -> ${targetPath}`);
      copyRecursiveSync(sourcePath, targetPath);
    }
  }
}

// Recursively copy directory
function copyRecursiveSync(src, dest) {
  const exists = fs.existsSync(src);
  const stats = exists && fs.statSync(src);
  const isDirectory = exists && stats.isDirectory();
  
  if (isDirectory) {
    fs.mkdirSync(dest, { recursive: true });
    fs.readdirSync(src).forEach(childItemName => {
      copyRecursiveSync(
        path.join(src, childItemName),
        path.join(dest, childItemName)
      );
    });
  } else {
    fs.copyFileSync(src, dest);
  }
}

// Fix imports in all JS files
function fixImportsInDirectory(dir) {
  const files = getAllJsFiles(dir);
  
  files.forEach(file => {
    fixImportsInFile(file);
  });
}

// Get all JS files recursively
function getAllJsFiles(dir, fileList = []) {
  const files = fs.readdirSync(dir);
  
  files.forEach(file => {
    const filePath = path.join(dir, file);
    const stat = fs.statSync(filePath);
    
    if (stat.isDirectory()) {
      getAllJsFiles(filePath, fileList);
    } else if (file.endsWith('.js')) {
      fileList.push(filePath);
    }
  });
  
  return fileList;
}

// Fix imports in a single file
function fixImportsInFile(filePath) {
  let content = fs.readFileSync(filePath, 'utf8');
  let modified = false;
  
  for (const [alias, packageName] of Object.entries(aliasMap)) {
    const regex = new RegExp(`require\\(['"]${alias}['"]\\)`, 'g');
    
    if (content.match(regex)) {
      // Calculate relative path from file to bundled package
      const fileDir = path.dirname(filePath);
      const distRoot = path.resolve(process.cwd(), 'dist');
      const packageBaseName = path.basename(packageName);
      const bundledPath = path.join(distRoot, packageBaseName);
      
      let relativePath = path.relative(fileDir, bundledPath);
      if (!relativePath.startsWith('.')) {
        relativePath = './' + relativePath;
      }
      
      content = content.replace(regex, `require('${relativePath}')`);
      modified = true;
    }
  }
  
  if (modified) {
    fs.writeFileSync(filePath, content);
    console.log(`✅ Fixed imports in: ${path.relative(process.cwd(), filePath)}`);
  }
}

// Main execution
if (require.main === module) {
  const packages = config.packages || [];
  
  packages.forEach(pkg => {
    if (pkg.distPath) {
      const distPaths = Array.isArray(pkg.distPath) 
        ? pkg.distPath 
        : [pkg.distPath];
      
      distPaths.forEach(distPath => {
        // Resolve glob patterns
        const resolvedPaths = distPath.includes('*') 
          ? require('glob').sync(distPath)
          : [distPath];
        
        resolvedPaths.forEach(resolvedPath => {
          if (fs.existsSync(resolvedPath)) {
            copyInternalPackages(pkg.path, resolvedPath);
            fixImportsInDirectory(resolvedPath);
          }
        });
      });
    }
  });
  
  console.log('✅ Bundling complete!');
}

module.exports = { fixImportsInFile, copyInternalPackages };