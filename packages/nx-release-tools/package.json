{
    "name": "@time4peter/nx-release-tools",
    "version": "1.0.2",
    "type": "commonjs",
    "description": "Reusable release automation tools for Nx monorepos",
    "keywords": [
        "nx",
        "release",
        "publish",
        "npm",
        "monorepo",
        "automation"
    ],
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "bin": {
